# Конфигурация сервера
PORT=3001
NODE_ENV=development

# Безопасность
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Базы данных
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=russian-trader
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader123

# Внешние API
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
MOEX_API_BASE_URL=https://iss.moex.com/iss
BINANCE_API_BASE_URL=https://api.binance.com/api/v3
TINKOFF_API_URL=https://invest-public-api.tbank.ru/rest/
TINKOFF_SANDBOX_API_URL=https://sandbox-invest-public-api.tbank.ru/rest/
TINKOFF_APP_NAME=russian-trader
TINKOFF_INVEST_TOKEN=
TINKOFF_SANDBOX=true
TINKOFF_ALLOW_INSECURE=false
TINKOFF_INSTRUMENTS_API_URL=https://invest-public-api.tbank.ru/rest/
TINKOFF_ERROR_SEED_FILE=data/tinkoff_error_map.json
TINKOFF_ERROR_SEED_ON_START=true

# AI (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com

# Broker callbacks
BROKER_CALLBACK_SECRET=change-me
TINKOFF_WEBHOOK_SECRET=change-me-too

# Crypto exchanges
BYBIT_API_URL=https://api.bybit.com
OKX_API_URL=https://www.okx.com
KUCOIN_API_URL=https://api.kucoin.com

# NATS
NATS_URL=nats://localhost:4222

# Alerts (SMTP)
SMTP_HOST=smtp.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=alerts@russian-trader.local
ALERT_EMAIL_TO=

# Slack / Telegram alerts
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vault/KMS
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT=secret

# Frontend URL для CORS
FRONTEND_URL=http://localhost:3002

# Логирование
LOG_LEVEL=info

# Лимиты API
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Настройки анализа
ANALYSIS_CACHE_TTL=300000
MARKET_DATA_UPDATE_INTERVAL=60000

# Тестовые данные (для разработки)
ENABLE_MOCK_DATA=true
