# --- Сервер ---
PORT=3001
NODE_ENV=development

# --- База данных (локально: docker compose up -d postgres) ---
DATABASE_URL=postgresql://trader:trader@localhost:5440/trader
# true для облачных БД с TLS (Amvera и т.п.)
DATABASE_SSL=false

# --- Вход в приложение (один пользователь) ---
# Пароль для входа, минимум 8 символов
APP_PASSWORD=
# Секрет подписи сессий, минимум 32 символа: openssl rand -hex 32
JWT_SECRET=

# --- AI (любой OpenAI-совместимый API) ---
# DeepSeek: ключ на https://platform.deepseek.com
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# Пример для Claude через OpenRouter:
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=anthropic/claude-sonnet-5.5

# --- Т-Инвестиции (T-Invest API): дивиденды, отчётность, торговля ---
# Токен: https://www.tbank.ru/invest/settings/api/ -> выпустить токен для песочницы.
# Для токена должно быть выключено «Подтверждение сделок кодом». Использовать в течение 7 дней после выпуска.
TINKOFF_TOKEN=
# true — песочница (виртуальные деньги, нужен Sandbox-токен); false — реальный счёт
TINKOFF_SANDBOX=true

# --- Telegram-дайджест по понедельникам в 09:00 МСК (необязательно) ---
# Токен бота от @BotFather и id вашего чата с ним (узнать: @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Локальные модели для агентов арены (Ollama): имена задаются как ollama/<модель>, ключ не нужен
# OLLAMA_URL=http://localhost:11434

# Passkey (Face ID): домен сайта и точный origin, как его видит браузер
# WEBAUTHN_RP_ID=trader.vlbrain.ru
# WEBAUTHN_ORIGINS=https://trader.vlbrain.ru
